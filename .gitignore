# ============================================================
# 根级 .gitignore —— 覆盖整个 monorepo（web / bff / job-service / analyzer）
# ============================================================

# ---- 本地 AI 工作区（含会话记忆、缓存，绝不入库）----
.workbuddy/
**/.workbuddy/

# ---- 环境变量 / 密钥（密钥绝不入库）----
.env
.env.local
.env.*.local
*.local

# ---- Node / 前端 ----
node_modules/
**/node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.eslintcache

# ---- Java / Maven ----
target/
**/target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
*.so
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
htmlcov/
.coverage

# ---- 日志 / 运行时产物 ----
*.log
logs/
*.pid
*.hprof

# ---- IDE / OS ----
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地数据 / 临时文件 ----
*.sqlite
*.db
*.h2.db
tmp/
temp/
