# ============================================================
# 根级 .gitignore —— 覆盖整个 monorepo（web / bff / job-service / analyzer）
# ============================================================

# ---- 本地 AI 工作区（含会话记忆、缓存，绝不入库）----
.workbuddy/
**/.workbuddy/

# ---- 环境变量 / 密钥（密钥绝不入库）----
.env
.env.local
.env.*.local
*.local

# ---- Node / 前端 ----
node_modules/
**/node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.eslintcache

# ---- Java / Maven ----
target/
**/target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
*.so
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
htmlcov/
.coverage

# ---- 日志 / 运行时产物 ----
*.log
logs/
*.pid
*.hprof

# ---- IDE / OS ----
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
desktop.ini
# Git Bash 崩溃时在**当前目录**丢下的转储文件（本项目全程在 Git Bash 下开发，见过）
*.stackdump

# ---- 本地数据 / 临时文件 ----
*.sqlite
*.db
*.h2.db
tmp/
temp/

# ---- 编辑 / 补丁的残留物 ----
# `patch` 失败、手工解冲突、或 IDE 生成备份时留下的伴生文件。
# 它们**不含任何有价值内容**，但很容易被 `git add .` 顺手带进仓库 ——
# 而一旦入库，评审者会以为是正式文件。
*.orig
*.rej
*.bak
