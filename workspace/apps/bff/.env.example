# BFF 环境变量样例 —— 复制为 .env 后按需修改
#
# ⚠️ 本文件**不含任何真实密钥**；.env 已在 .gitignore 里，永不入库。

# ---- 服务 ----
BFF_PORT=3000
LOG_LEVEL=info

# ---- 下游 ----
# C3 严格线性：BFF 只与 Java 对话，**禁止**直连 Python（spec.md §2.7 / 附录 C）
JOB_SERVICE_URL=http://localhost:8080

# ---- part2 M6.1：上传 ----
# 与 Java / Python 同一口径（spec.md §2.5 的 10 MB）。
# 改这个值不会生效 —— 上限由 config/constants.ts 的 MAX_UPLOAD_BYTES 冻结，
# 本变量只作文档与部署备忘（避免有人以为改这里就能放行更大的文件）。
MAX_UPLOAD_MB=10
