{
  "name": "@careerlens/bff",
  "version": "0.1.0",
  "private": true,
  "description": "CareerLens BFF —— 面向客户端的适配层（输入校验 / 请求编排 / 超时 / 错误映射 / 结果聚合 / traceId 下发）",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@koa/router": "^13.1.0",
    "dotenv": "^16.4.7",
    "koa": "^2.15.3",
    "pino": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
