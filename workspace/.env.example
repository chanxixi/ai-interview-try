# ============================================================
# CareerLens 环境变量模板
# 用法：cp .env.example .env  然后填入真实值
# 注意：.env 已在 .gitignore 中，密钥绝不入库（spec.md §3.3）
# ============================================================

# ---- LLM（OpenAI-compatible 网关）----
# base_url 末尾不要带斜杠，避免拼成 /v1/v1/chat/completions
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# ---- 服务端口 ----
WEB_PORT=5173
BFF_PORT=3000
JOB_SERVICE_PORT=8080
ANALYZER_PORT=8000

# ---- 服务发现（BFF → Java → Python 线性链）----
JOB_SERVICE_URL=http://localhost:8080
ANALYZER_URL=http://localhost:8000
BFF_URL=http://localhost:3000

# ---- 存储（**现状**：两档 + 部署期切换）----
# ⚠️ part1 spec §2.9 承诺的是「三档自动降级（mysql → local → mock），
#    由 app.storage.mode=auto 在启动时逐个探测」——**该机制未实现**，
#    `/healthz` 也不返回 storage 字段。原因与补齐路径见 DELIVERY.md §7 D-9。
#
# 实际生效的是这两档（同一套 Repository，靠数据源 URL 切）：
#   ① 留空        → H2 内存库（默认）。零外部依赖，克隆下来即可运行
#   ② 指向 MySQL  → 主路径。两档共用同一份 schema + seed，所以**换存储不换分数**
JOB_DB_URL=
JOB_DB_DRIVER=
JOB_DB_USER=
JOB_DB_PASSWORD=
# 决定加载哪份 schema：h2 → db/h2/schema.sql，mysql → db/mysql/schema.sql
JOB_DB_DIALECT=h2

# ---- 超时矩阵（plan.md §6.1，单位毫秒；**外层必须 > 内层**）----
JOB_SERVICE_TIMEOUT_MS=5000
ANALYZER_TIMEOUT_MS=110000

# ---- 日志 ----
LOG_LEVEL=info
