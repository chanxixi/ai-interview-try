# ============================================================
# CareerLens 环境变量模板
# 用法：cp .env.example .env  然后填入真实值
# 注意：.env 已在 .gitignore 中，密钥绝不入库（spec.md §3.3）
# ============================================================

# ---- LLM（OpenAI-compatible 网关）----
# base_url 末尾不要带斜杠，避免拼成 /v1/v1/chat/completions
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# ---- 服务端口 ----
WEB_PORT=5173
BFF_PORT=3000
JOB_SERVICE_PORT=8080
ANALYZER_PORT=8000

# ---- 服务发现（BFF → Java → Python 线性链）----
JOB_SERVICE_URL=http://localhost:8080
ANALYZER_URL=http://localhost:8000
BFF_URL=http://localhost:3000

# ---- 存储（plan.md §4 / spec.md §2.9）----
# STORAGE_MODE: auto | mysql | local | mock
#   auto  = 启动时按 mysql → local → mock 顺序探测，第一个成功即停（默认）
#   mysql = 强制走 MySQL，连不上直接启动失败（不静默降级）
#   local = 强制走 H2（MODE=MySQL）
#   mock  = 强制走 Java 层内置数据
STORAGE_MODE=auto
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=careerlens
MYSQL_USER=careerlens
MYSQL_PASSWORD=
# 容器内由 compose 覆盖为 mysql；本地直连时保持 localhost
MYSQL_ROOT_PASSWORD=

# ---- 超时矩阵（plan.md §6.1，单位毫秒）----
JOB_SERVICE_TIMEOUT_MS=5000
ANALYZER_TIMEOUT_MS=45000

# ---- 日志 ----
LOG_LEVEL=info
